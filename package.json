{
  "name": "dsh-memory-guardian",
  "version": "0.1.1-beta.1",
  "description": "Governed, privacy-aware long-term memory for DeepSeek Harness with provenance, conflict detection, recall budgets, and a polished Web dashboard.",
  "author": "weixin_51155543",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./store": {
      "types": "./lib/store.d.ts",
      "default": "./lib/store.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node --check src/scope.js && node --check src/store.js && node --check src/index.js && node --check src/client.js",
    "test": "npm run build && node --test",
    "pack:check": "npm pack --dry-run --cache ./.cache/npm"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agent-memory",
    "memory-governance",
    "privacy",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ukashi0/dsh-memory-guardian.git"
  },
  "homepage": "https://github.com/Ukashi0/dsh-memory-guardian#readme",
  "bugs": {
    "url": "https://github.com/Ukashi0/dsh-memory-guardian/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "react": ">=18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "react": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
